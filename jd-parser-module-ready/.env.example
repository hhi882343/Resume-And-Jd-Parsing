# =============================================================================
# JD Parser Module - Environment Configuration Template
# Copy this file to .env and configure your API keys.
# =============================================================================

# Primary LLM Provider: Google Gemini
# Recommended: gemini-2.5-flash-lite (fastest, lowest cost, structured JSON native)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Fallback LLM Provider 1: SambaNova Cloud (Llama 3.3 70B Instruct)
# Activated automatically if Gemini returns 429, 503, or rate limit quota exhaustion
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Fallback LLM Provider 2: Groq Cloud (Llama 3.3 70B Versatile)
# Optional fallback when SambaNova is unavailable
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM Provider 3: OpenRouter
# Optional final fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Database (Optional: only needed if persisting runs and feedback)
# Default is in-memory or embedded sqlite
DATABASE_URL=sqlite+aiosqlite:///data/feedback.db

# Application Timezone (Optional: defaults to system local or UTC)
# APP_TIMEZONE=UTC

# API Server Configuration (FastAPI)
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_DOCS=true
CORS_ORIGINS=*

# Optional API Security
API_KEY_AUTH_ENABLED=false
APP_API_KEY=your-optional-secret-key-here

