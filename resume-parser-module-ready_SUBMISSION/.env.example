# ==============================================================================
# Resume Parser Module - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Note: GEMINI_API_KEY is optional. If omitted or empty, the module operates in
# 100% deterministic local mode with zero external cloud dependencies.
# ==============================================================================

# Gemini AI API Key (Optional)
GEMINI_API_KEY=

# Primary Gemini Model for resume extraction (defaults to gemini-2.5-flash-lite)
GEMINI_MODEL=

# Comma-separated list of fallback Gemini models (defaults to gemini-2.5-flash,gemini-2.0-flash)
GEMINI_FALLBACK_MODELS=

# HTTP Service Port (defaults to 3001)
PORT=

# Node.js binary path for document text extraction helpers in tools/ (defaults to 'node' on PATH)
NODE_BIN=

# Tesseract OCR traineddata directory (defaults to assets/tessdata)
TESSDATA_DIR=

# Server Timezone (defaults to UTC)
TZ=UTC
